# ==============================================================================
# Saarthi AI Monorepo — Environment Variable Template
# ==============================================================================
# DO NOT ADD REAL SECRETS OR SENSITIVE CREDENTIALS TO THIS FILE.
# This template is tracked in Git to document the required environment variables.
# Copy this file to:
#   - apps/backend/.env (for Backend service)
#   - apps/web/.env.local (for Frontend Next.js app)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (apps/backend/.env)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for server-side token signing (min 32 chars)
JWT_SECRET=your_jwt_secret_key_change_before_production

# CORS allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://saarthi-ai.vercel.app

# Google Gemini API Key for AI Copilot & Scheme Guidance
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-latest

# Auth Rate Limiting (max attempts per 5-minute window)
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/.env.local)
# ------------------------------------------------------------------------------
# Public API base URL accessed by browser clients
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public website URL (for SEO, metadata, sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-to-server rewrite destination for Next.js proxying
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

