# Saarthi AI Frontend Environment Configuration Template
# Copy this file to .env.local for local development or set in Vercel / Netlify Environment Variables

# Backend API Endpoint (publicly reachable URL for browser requests)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical Production Website URL (used for Open Graph & Sitemap generation)
NEXT_PUBLIC_SITE_URL=https://saarthi-ai.vercel.app

# Optional: Internal backend URL for Next.js server-side rewrites (e.g. within Docker or private VPC)
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
