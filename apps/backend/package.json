{
  "name": "@saarthi/backend",
  "version": "0.1.0",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "prisma generate && prisma db push --accept-data-loss && tsc",
    "start": "prisma db push --accept-data-loss && node dist/src/scripts/seedAdmin.js && node dist/src/index.js",
    "dev": "node --watch -r ts-node/register src/index.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "promote:admin": "ts-node src/scripts/promoteSuperAdmin.ts",
    "test:readiness": "ts-node src/scripts/verifyLaunchReadiness.ts",
    "test:phase1": "ts-node test/phase1.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.22.0",
    "saarthi-ai-monorepo": "file:../..",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  }
}
