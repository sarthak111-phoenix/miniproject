# Saarthi AI Backend Environment Configuration Template
# Copy this file to .env and configure your production secrets.
# NEVER commit the active .env file to Git or version control.

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# SQLite database path (or PostgreSQL / MySQL connection string for production)
DATABASE_URL="file:./dev.db"

# Cryptographically strong JWT Secret Key (min 32 characters)
# Generate a strong key with: openssl rand -base64 32
JWT_SECRET=your_production_jwt_secret_key_change_me_before_deploying

# Allowed CORS Origins (comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=https://saarthi-ai.vercel.app,http://localhost:3000

# Google Gemini API Key for Grounded RAG Chat & AI Copilot
# Obtain securely from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-latest

# Optional Auth Rate Limiting Override (maximum attempts per 5-minute sliding window)
AUTH_RATE_LIMIT_MAX=5
